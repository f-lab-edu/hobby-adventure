{
  "id": null,
  "uid": "image-performance",
  "title": "Image Loading Performance (S3 vs CloudFront)",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Image Fetch Duration (median / p95)",
      "type": "timeseries",
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "k6_image_fetch_duration_med",
          "legendFormat": "median",
          "refId": "A"
        },
        {
          "expr": "k6_image_fetch_duration_p95",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "k6 Error Rate",
      "type": "timeseries",
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "k6_http_req_failed_rate",
          "legendFormat": "status {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "S3 Requests",
      "type": "timeseries",
      "datasource": "cloudwatch",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "namespace": "AWS/S3",
          "metricName": "AllRequests",
          "statistic": "Sum",
          "dimensions": {
            "BucketName": "hobby-adventure-bucket",
            "FilterId": "EntireBucket"
          },
          "region": "ap-northeast-2",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "CloudFront Requests / Cache Hit Rate",
      "type": "timeseries",
      "datasource": "cloudwatch",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "namespace": "AWS/CloudFront",
          "metricName": "Requests",
          "statistic": "Sum",
          "region": "us-east-1",
          "refId": "A"
        },
        {
          "namespace": "AWS/CloudFront",
          "metricName": "CacheHitRate",
          "statistic": "Average",
          "region": "us-east-1",
          "refId": "B"
        }
      ]
    }
  ]
}
